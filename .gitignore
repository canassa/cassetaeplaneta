# Disc image (assets/ holds its extracted contents)
*.iso

# Temporary link to assets/ for old paths
/NOITE_ANIMAL

# Ghidra project database, locks and logs
ghidra/noite.rep/
ghidra/*.lock
ghidra/*.lock~
ghidra/import.log

# Compiled scripts and Python caches
*.class
__pycache__/

# Nix / direnv
.direnv/

# Zig build output
.zig-cache/
zig-out/

# Python / uv
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Port worktrees (one per claimed unit; see `noite start`) and their
# reference dumps
/work/
.ref/

# Port tracker DB (local; rebuild with `noite import`)
db/*.sqlite*

# Saved games written by the port (platform save dir)
/save/
